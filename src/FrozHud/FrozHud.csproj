<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- The project folder is still named FrozHud from the original scaffold,
         but the shipped MelonLoader mod DLL and in-game mod name are FrozTLDMod. -->
    <AssemblyName>FrozTLDMod</AssemblyName>
    <RootNamespace>FrozTLDMods.FrozTLDMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader requires this marker before it scans a nested mod folder. -->
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime dependencies come from the local game install. They are not
         copied into the mod output and should not be committed to the repo. -->
    <Reference Include="0Harmony">
      <HintPath>$(TldMelonLoaderDir)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(TldMelonLoaderDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(TldMelonLoaderDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModSettings">
      <HintPath>$(TldGameDir)\Mods\ModSettings.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- IL2CPP interop assemblies are generated by MelonLoader after launching
         The Long Dark once with MelonLoader installed. -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(TldInteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TldInteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppTLD.IntBackedUnit">
      <HintPath>$(TldInteropDir)\Il2CppTLD.IntBackedUnit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppTLD.PDID">
      <HintPath>$(TldInteropDir)\Il2CppTLD.PDID.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppTLD.SaveState">
      <HintPath>$(TldInteropDir)\Il2CppTLD.SaveState.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppAK.Wwise.Unity.API.WwiseTypes">
      <HintPath>$(TldInteropDir)\Il2CppAK.Wwise.Unity.API.WwiseTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TldInteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(TldInteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(TldInteropDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(TldInteropDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(TldInteropDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so FrozTLDMod.dll is self-contained after deployment. -->
    <EmbeddedResource Include="Assets\ico_GearItem__Stick.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.ico_GearItem__Stick.png" />
    <EmbeddedResource Include="Assets\ico_Radial_pack.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.ico_Radial_pack.png" />
    <EmbeddedResource Include="Assets\ico_TechnicalBackpack.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.ico_TechnicalBackpack.png" />
    <EmbeddedResource Include="Assets\dialBackground.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.dialBackground.png" />
    <EmbeddedResource Include="Assets\dialOverlayCompass.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.dialOverlayCompass.png" />
    <EmbeddedResource Include="Assets\dialCompassStick.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.dialCompassStick.png" />
    <EmbeddedResource Include="Assets\dialTriangleMarkerIn.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.dialTriangleMarkerIn.png" />
    <EmbeddedResource Include="Assets\dialTriangleMarkerOut.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.dialTriangleMarkerOut.png" />
    <EmbeddedResource Include="Assets\clockDialHand.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.clockDialHand.png" />
    <EmbeddedResource Include="Assets\scentActive.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.scentActive.png" />
    <EmbeddedResource Include="Assets\scentBackground.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.scentBackground.png" />
    <EmbeddedResource Include="Assets\stick_compass_back.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.stick_compass_back.png" />
    <EmbeddedResource Include="Assets\stick_compass_disabled.png" LogicalName="FrozTLDMods.FrozTLDMod.Assets.stick_compass_disabled.png" />
  </ItemGroup>
</Project>
